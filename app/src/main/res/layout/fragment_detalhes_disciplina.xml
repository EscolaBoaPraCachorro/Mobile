<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/detalhesDisciplina"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4232B2"
    android:backgroundTint="#4232B2"
    tools:context=".DetalhesDisciplina"
    tools:layout_editor_absoluteX="-29dp"
    tools:layout_editor_absoluteY="156dp">

    <View
        android:id="@+id/view3"
        android:layout_width="351dp"
        android:layout_height="89dp"
        android:layout_marginTop="112dp"
        android:background="#FF9800"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/fotoProfessor"
        android:layout_width="124dp"
        android:layout_height="112dp"
        android:scaleType="centerCrop"
        android:src="@drawable/profeduble"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.062"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.159"
        app:shapeAppearanceOverlay="@style/ImagemRedonda"
        app:strokeColor="@color/white" />

    <ImageView
        android:id="@+id/voltar"
        android:layout_width="49dp"
        android:layout_height="55dp"
        android:layout_marginTop="16dp"
        android:rotation="180"
        android:src="@drawable/seta_comeback"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.049"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/view4"
        android:layout_width="128dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="14dp"
        android:background="#8BC34A"
        android:backgroundTint="#8BC34A"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/view3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/view3">

        <TextView
            android:id="@+id/nomeDisciplina"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="@font/josefin_sans"
            android:gravity="center|center_horizontal|center_vertical"
            android:text="disciplina"
            android:textSize="16sp"
            android:textStyle="bold" />


    </com.google.android.material.card.MaterialCardView>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        app:layout_constraintTop_toBottomOf="@+id/view3"
        app:layout_constraintBottom_toTopOf="@+id/card2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/card_nota" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card2"
        android:layout_width="386dp"
        android:layout_height="175dp"
        android:layout_marginTop="372dp"
        android:background="#FFFFFF"
        android:backgroundTint="#FFFFFF"
        app:cardCornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view3">


        <TextView
            android:id="@+id/observacoes"
            android:layout_width="342dp"
            android:layout_height="135dp"
            android:layout_marginTop="19dp"
            android:fontFamily="@font/josefin_sans"
            android:text="Observações"
            android:textSize="20sp" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/nomeProf"
        android:layout_width="82dp"
        android:layout_height="34dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="124dp"
        android:text="TextView"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.07"
        app:layout_constraintStart_toStartOf="@+id/fotoProfessor"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/idadeProf"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="120dp"
        android:layout_marginTop="160dp"
        android:text="TextView"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.07"
        app:layout_constraintStart_toStartOf="@+id/fotoProfessor"
        app:layout_constraintTop_toTopOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>