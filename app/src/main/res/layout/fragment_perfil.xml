<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4232B2">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFotoPet"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgPet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/dogduble"
            tools:srcCompat="@drawable/dogduble" />

        <ImageButton
            android:id="@+id/voltarPerfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="?attr/homeAsUpIndicator"
            app:tint="#090909" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/containerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/shape_rounded_top"
        android:backgroundTint="#FFFFFF"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardFotoPet">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/txtNomePet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Nome"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/btnLogout"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageButton
                android:id="@+id/btnLogout"
                android:layout_width="60dp"
                android:layout_height="65dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:scaleType="fitCenter"
                app:layout_constraintBottom_toBottomOf="@+id/txtNomePet"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/txtNomePet"
                app:srcCompat="@drawable/common_full_open_on_phone"
                app:tint="#FFFFFF" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/racaidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Idade anos • Raça"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="401dp"
            android:layout_height="62dp"
            android:layout_marginTop="20dp"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/turma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" TURMA"
                android:textSize="16sp"
                app:chipBackgroundColor="#E8F5E9"
                app:chipIcon="@android:drawable/ic_menu_myplaces"
                app:chipIconTint="#4CAF50" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sexo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MACHO"
                app:chipBackgroundColor="#E3F2FD"
                app:chipIconTint="#2196F3" />

        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#EEEEEE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESPONSÁVEL"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgTutor"
                android:layout_width="101dp"
                android:layout_height="95dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                tools:srcCompat="@drawable/profduble" />

            <TextView
                android:id="@+id/txtNomeTutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:text="Jorge da Silva"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/txtIdadeTutor"
                app:layout_constraintStart_toEndOf="@id/imgTutor"
                app:layout_constraintTop_toTopOf="@id/imgTutor" />

            <TextView
                android:id="@+id/txtIdadeTutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 anos"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                app:layout_constraintBottom_toBottomOf="@id/imgTutor"
                app:layout_constraintStart_toStartOf="@id/txtNomeTutor"
                app:layout_constraintTop_toBottomOf="@id/txtNomeTutor" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>