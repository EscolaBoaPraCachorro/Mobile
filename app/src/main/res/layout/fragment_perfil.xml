<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#4232B2">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardFotoPet"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        app:cardElevation="0dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgPet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/dogduble"
            tools:srcCompat="@drawable/dogduble" />

        <View
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:alpha="0.2"
            android:background="@android:drawable/screen_background_dark_transparent" />

        <ImageButton
            android:id="@+id/voltarPerfil"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Voltar"
            android:src="?attr/homeAsUpIndicator"
            app:tint="@color/black" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/containerInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-30dp"
        android:background="@drawable/shape_rounded_top"
        android:backgroundTint="#FFFFFF"
        android:orientation="vertical"
        android:padding="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cardFotoPet">

        <TextView
            android:id="@+id/txtNomePet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cural da Silva"
            android:textColor="#FFFFFF"
            android:textColorHint="#FAF7F7"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/racaidade"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 anos • Golden Retriever"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:chipSpacingHorizontal="8dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/turma"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sala 1"
                app:chipBackgroundColor="#E8F5E9"
                app:chipIcon="@android:drawable/ic_menu_myplaces"
                app:chipIconTint="#4CAF50" />

            <com.google.android.material.chip.Chip
                android:id="@+id/sexo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Macho"
                app:chipBackgroundColor="#E3F2FD"
                app:chipIconTint="#2196F3" />

            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SRD"
                app:chipBackgroundColor="#F5F5F5" />
        </com.google.android.material.chip.ChipGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="24dp"
            android:background="#EEEEEE" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RESPONSÁVEL"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgTutor"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.SmallComponent"
                tools:srcCompat="@drawable/profduble" />

            <TextView
                android:id="@+id/txtNomeTutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="Jorge da Silva"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@id/txtIdadeTutor"
                app:layout_constraintStart_toEndOf="@id/imgTutor"
                app:layout_constraintTop_toTopOf="@id/imgTutor" />

            <TextView
                android:id="@+id/txtIdadeTutor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="30 anos"
                android:textColor="#FFFFFF"
                app:layout_constraintBottom_toBottomOf="@id/imgTutor"
                app:layout_constraintStart_toStartOf="@id/txtNomeTutor"
                app:layout_constraintTop_toBottomOf="@id/txtNomeTutor" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>